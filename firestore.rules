rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =====================================================
       1. COMMON HELPERS
    ===================================================== */

    function signed() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signed() && request.auth.uid == uid;
    }

    function validText(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    // Chat member validation
    function chatMember(chatId) {
      let chatPath =
        /databases/$(database)/documents/chats/$(chatId);

      return signed()
        && exists(chatPath)
        && get(chatPath).data.participants is list
        && get(chatPath).data.participants.size() == 2
        && request.auth.uid in get(chatPath).data.participants;
    }

    // New chat creation validation
    function newChatMember(chatId) {
      let participants = request.resource.data.participants;

      return signed()
        && participants is list
        && participants.size() == 2
        && participants[0] is string
        && participants[1] is string
        && participants[0] != participants[1]
        && request.auth.uid in participants

        && chatId == (
          participants[0] < participants[1]
            ? participants[0] + "_" + participants[1]
            : participants[1] + "_" + participants[0]
        )

        && request.resource.data.keys().hasOnly([
          "participants",
          "updatedAt"
        ])

        && request.resource.data.updatedAt is timestamp;
    }
    /* =====================================================
       2. POST LIKE VALIDATION
    ===================================================== */

    function validLikeCountUpdate(postId) {

      let likePath =
        /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);

      let oldCount = resource.data.get("likesCount", 0);
      let newCount = request.resource.data.get("likesCount", -1);

      return signed()

        && oldCount is int
        && oldCount >= 0

        && newCount is int
        && newCount >= 0

        && request.resource.data.updatedAt is timestamp

        && resource.data.userId != request.auth.uid

        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["likesCount", "updatedAt"])

        && (
          (
            newCount == oldCount + 1
            && !exists(likePath)
            && existsAfter(likePath)
            && getAfter(likePath).data.userId
              == request.auth.uid
          )

          ||

          (
            newCount == oldCount - 1
            && oldCount > 0
            && exists(likePath)
            && !existsAfter(likePath)
            && get(likePath).data.userId
              == request.auth.uid
          )
        );
    }


    /* =====================================================
       3. COMMENT COUNT VALIDATION
    ===================================================== */

    function validCommentCountUpdate(postId) {

      let commentId = request.resource.data.get(
        "lastCommentId",
        "invalid"
      );

      let commentPath =
        /databases/$(database)/documents/posts/$(postId)/comments/$(commentId);

      let oldCount = resource.data.get("commentsCount", 0);
      let newCount = request.resource.data.get("commentsCount", -1);

      return signed()

        && commentId is string
        && commentId.size() > 0

        && oldCount is int
        && oldCount >= 0

        && newCount is int
        && newCount == oldCount + 1

        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["commentsCount", "lastCommentId"])

        && !exists(commentPath)
        && existsAfter(commentPath)

        && getAfter(commentPath).data.postId == postId
        && getAfter(commentPath).data.userId == request.auth.uid
        && getAfter(commentPath).data.deleted == false;
    }


    /* =====================================================
       4. REPLY COUNT VALIDATION
    ===================================================== */

    function validReplyCountUpdate(postId, commentId) {

      let replyId = request.resource.data.get(
        "lastReplyId",
        "invalid"
      );

      let replyPath =
        /databases/$(database)/documents/posts/$(postId)/comments/$(replyId);

      let oldCount = resource.data.get("repliesCount", 0);
      let newCount = request.resource.data.get("repliesCount", -1);

      return signed()

        && resource.data.deleted == false

        && replyId is string
        && replyId.size() > 0

        && oldCount is int
        && oldCount >= 0

        && newCount is int
        && newCount == oldCount + 1

        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["repliesCount", "lastReplyId"])

        && !exists(replyPath)
        && existsAfter(replyPath)

        && getAfter(replyPath).data.postId == postId
        && getAfter(replyPath).data.parentCommentId == commentId
        && getAfter(replyPath).data.userId == request.auth.uid
        && getAfter(replyPath).data.deleted == false;
    }


    /* =====================================================
       5. CALL HELPERS
    ===================================================== */

    function validCall(data, callId) {

      return data.callerID is string
        && data.receiverID is string

        && data.callerID != data.receiverID

        && data.roomID is string
        && data.roomID == callId

        && data.participantIDs is list
        && data.participantIDs.size() == 2

        && data.callerID in data.participantIDs
        && data.receiverID in data.participantIDs

        && data.type in ["voice", "video"]

        && data.status in [
          "calling",
          "accepted",
          "ongoing",
          "rejected",
          "ended",
          "timeout",
          "missed"
        ];
    }

    function isCallParticipant(data) {
      return signed()
        && data.participantIDs is list
        && data.participantIDs.size() == 2
        && request.auth.uid in data.participantIDs;
    }

    function validCallTransition(
      oldStatus,
      newStatus,
      caller,
      receiver
    ) {

      return (

        (
          oldStatus == "calling"

          && (
            (
              newStatus in ["accepted", "rejected"]
              && request.auth.uid == receiver
            )

            ||

            (
              newStatus in ["ended", "timeout", "missed"]
              && request.auth.uid in [caller, receiver]
            )
          )
        )

        ||

        (
          oldStatus == "accepted"
          && newStatus in ["ongoing", "ended"]
          && request.auth.uid in [caller, receiver]
        )

        ||

        (
          oldStatus == "ongoing"
          && newStatus == "ended"
          && request.auth.uid in [caller, receiver]
        )
      );
    }


    /* =====================================================
       6. CALL LOG HELPERS
    ===================================================== */

    function validCallType(type) {
      return type in ["voice", "video"];
    }

    function allowedCallStatus(status) {
      return status in [
        "calling",
        "accepted",
        "ongoing",
        "ended",
        "rejected",
        "timeout",
        "missed"
      ];
    }

    function isLogParticipant(data) {

      return signed()

        && data.participantIDs is list
        && data.participantIDs.size() == 2

        && request.auth.uid in data.participantIDs

        && data.callerID is string
        && data.receiverID is string

        && data.callerID != data.receiverID

        && data.callerID in data.participantIDs
        && data.receiverID in data.participantIDs;
    }

    function validLog(data, roomID) {

      return data.roomID == roomID

        && data.callerID is string
        && data.receiverID is string

        && data.participantIDs is list
        && data.participantIDs.size() == 2

        && data.callerID != data.receiverID

        && data.callerID in data.participantIDs
        && data.receiverID in data.participantIDs

        && validCallType(data.type)
        && allowedCallStatus(data.status)

        && data.createdAt is timestamp
        && data.updatedAt is timestamp

        && data.keys().hasAll([
          "roomID",
          "callerID",
          "receiverID",
          "participantIDs",
          "type",
          "status",
          "createdAt",
          "updatedAt"
        ])

        && data.keys().hasOnly([
          "roomID",
          "callerID",
          "receiverID",
          "participantIDs",
          "callerName",
          "receiverName",
          "type",
          "status",
          "createdAt",
          "updatedAt",
          "hiddenFor"
        ])

        && (
          !data.keys().hasAny(["callerName"])
          || (
            data.callerName is string
            && data.callerName.size() <= 80
          )
        )

        && (
          !data.keys().hasAny(["receiverName"])
          || (
            data.receiverName is string
            && data.receiverName.size() <= 80
          )
        )

        && (
          !data.keys().hasAny(["hiddenFor"])
          || (
            data.hiddenFor is list
            && data.hiddenFor.size() <= 2
            && data.hiddenFor.hasOnly(data.participantIDs)
          )
        );
    }

    function matchesCall(data, roomID) {

      let callPath =
        /databases/$(database)/documents/calls/$(roomID);

      return exists(callPath)

        && get(callPath).data.callerID == data.callerID
        && get(callPath).data.receiverID == data.receiverID

        && get(callPath).data.participantIDs
          == data.participantIDs

        && get(callPath).data.type == data.type

        && get(callPath).data.createdAt is timestamp

        && get(callPath).data.createdAt == data.createdAt;
    }

    function validLogStatusUpdate() {

      return request.resource.data.status == resource.data.status

        || validCallTransition(
          resource.data.status,
          request.resource.data.status,
          resource.data.callerID,
          resource.data.receiverID
        );
    }

    function validHideUpdate() {

      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(["hiddenFor"])

        && request.resource.data.hiddenFor is list
        && request.resource.data.hiddenFor.size() <= 2

        && request.auth.uid in resource.data.participantIDs
        && request.auth.uid in request.resource.data.hiddenFor

        && (

          (
            !resource.data.keys().hasAny(["hiddenFor"])
            && request.resource.data.hiddenFor.size() == 1
          )

          ||

          (
            resource.data.hiddenFor is list

            && !(request.auth.uid in resource.data.hiddenFor)

            && request.resource.data.hiddenFor.hasAll(
              resource.data.hiddenFor
            )

            && request.resource.data.hiddenFor.size()
              == resource.data.hiddenFor.size() + 1
          )
        );
    }


    /* =====================================================
       7. USERS
    ===================================================== */

    match /users/{uid} {

  /* =========================================
     USER PROFILE READ
  ========================================= */

  allow get, list: if signed();


  /* =========================================
     USER PROFILE CREATE
  ========================================= */

  allow create: if isMe(uid)

    && request.resource.data.uid == uid

    && !request.resource.data.keys().hasAny([
      "role",
      "isAdmin",
      "admin",
      "customClaims"
    ]);


  /* =========================================
     USER PROFILE UPDATE
  ========================================= */

  allow update: if isMe(uid)

    && request.resource.data.uid == resource.data.uid

    && request.resource.data.diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "uid",
        "name",
        "nameLower",
        "userName",
        "userNameLower",
        "displayName",
        "email",
        "bio",
        "location",
        "gender",
        "birthDate",
        "job",
        "education",
        "university",
        "major",
        "facebook",
        "telegram",
        "photoURL",
        "userPic",
        "profilePic",

        "settings",

        "postPrivacy",
        "commentPrivacy",
        "downloadPrivacy",
        "notifyEmail",
        "notifySound",
        "appLang",
        "paymentMethod",
        "screenshotProtection",

        "phone",
        "phoneNumber",
        "phonePublic",
        "publicPhone",

        "updatedAt",
        "status",
        "isOnline",
        "lastSeen",
        "postsCount",

        "blockedUsers",
        "blockedBy",

        "eulaAccepted",
        "eulaAcceptedAt"
      ])

    /* EULA VALIDATION */
    && (
      !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(["eulaAccepted"])
      || request.resource.data.eulaAccepted is bool
    )

    && (
      !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(["eulaAcceptedAt"])
      || request.resource.data.eulaAcceptedAt is timestamp
    )

    /* ADMIN PRIVILEGE PROTECTION */
    && !request.resource.data.diff(resource.data)
      .affectedKeys()
      .hasAny([
        "role",
        "isAdmin",
        "admin",
        "customClaims"
      ]);


  /* =========================================
     USER PROFILE DELETE
  ========================================= */

  allow delete: if isMe(uid);

  /* =========================================
     NOTIFICATION SETTINGS
     ORO-CONNECT PRODUCTION
  ========================================= */

  match /settings/{settingId} {

    allow get: if isMe(uid)
      && settingId == "notifications";

    allow list: if false;

    allow create, update: if isMe(uid)

      && settingId == "notifications"

      && request.resource.data.keys().hasOnly([
        "likes",
        "comments",
        "messages",
        "calls",
        "mentions",
        "shares",
        "push",
        "sound",
        "dnd",
        "dndStart",
        "dndEnd",
        "timezone"
      ])

      // Boolean validation
      && (
        !request.resource.data.keys().hasAny(["likes"])
        || request.resource.data.likes is bool
      )

      && (
        !request.resource.data.keys().hasAny(["comments"])
        || request.resource.data.comments is bool
      )

      && (
        !request.resource.data.keys().hasAny(["messages"])
        || request.resource.data.messages is bool
      )

      && (
        !request.resource.data.keys().hasAny(["calls"])
        || request.resource.data.calls is bool
      )

      && (
        !request.resource.data.keys().hasAny(["mentions"])
        || request.resource.data.mentions is bool
      )

      && (
        !request.resource.data.keys().hasAny(["shares"])
        || request.resource.data.shares is bool
      )

      && (
        !request.resource.data.keys().hasAny(["push"])
        || request.resource.data.push is bool
      )

      && (
        !request.resource.data.keys().hasAny(["sound"])
        || request.resource.data.sound is bool
      )

      && (
        !request.resource.data.keys().hasAny(["dnd"])
        || request.resource.data.dnd is bool
      )

      // DND start time
      && (
        !request.resource.data.keys().hasAny(["dndStart"])
        || (
          request.resource.data.dndStart is string
          && request.resource.data.dndStart.matches(
            '^([01][0-9]|2[0-3]):[0-5][0-9]$'
          )
        )
      )

      // DND end time
      && (
        !request.resource.data.keys().hasAny(["dndEnd"])
        || (
          request.resource.data.dndEnd is string
          && request.resource.data.dndEnd.matches(
            '^([01][0-9]|2[0-3]):[0-5][0-9]$'
          )
        )
      )

      // Timezone
      && (
        !request.resource.data.keys().hasAny(["timezone"])
        || (
          request.resource.data.timezone is string
          && request.resource.data.timezone.size() <= 100
        )
      );

    allow delete: if isMe(uid)
      && settingId == "notifications";
  }
  /* =========================================
     PRIVATE USER DATA
  ========================================= */

  match /private/{document} {

    allow get: if isMe(uid);

    allow list: if false;

    /* PRIVATE CONTACT */
    allow create, update: if isMe(uid)

      && document == "contact"

      && request.resource.data.keys().hasOnly([
        "phoneNumber",
        "updatedAt"
      ])

      && request.resource.data.phoneNumber is string

      && request.resource.data.phoneNumber.size() <= 40

      && request.resource.data.updatedAt is timestamp;

    allow delete: if isMe(uid);
  }

  /* =========================================
     FCM DEVICE TOKENS
     ORO-CONNECT PRODUCTION
  ========================================= */

  match /private/fcm/tokens/{tokenId} {

    // Token ofii isaa qofa dubbisuu.
    allow get: if isMe(uid);

    // Token list guutuu hin hayyamamu.
    allow list: if false;

    // Register / refresh device token.
    allow create, update: if isMe(uid)

      && request.resource.data.keys().hasAll([
        "fcmToken",
        "platform",
        "lastTokenUpdate",
        "active"
      ])

      && request.resource.data.keys().hasOnly([
        "fcmToken",
        "platform",
        "userAgent",
        "lastTokenUpdate",
        "active"
      ])

      && request.resource.data.fcmToken == tokenId

      && request.resource.data.platform == "web"

      && request.resource.data.lastTokenUpdate is timestamp

      && request.resource.data.active is bool

      && (
        !request.resource.data.keys().hasAny(["userAgent"])
        || (
          request.resource.data.userAgent is string
          && request.resource.data.userAgent.size() <= 1000
        )
      );

    // Device token haquu.
    allow delete: if isMe(uid);
  }
  /* =========================================
     FOLLOWERS
  ========================================= */

  match /followers/{followerUid} {

    allow read: if signed();

    allow create: if isMe(followerUid)

      && followerUid != uid

      && request.resource.data.uid == followerUid;

    allow delete: if isMe(followerUid);

    allow update: if false;
  }


  /* =========================================
     FOLLOWING
  ========================================= */

  match /following/{followingUid} {

    allow read: if signed();

    allow create: if isMe(uid)

      && followingUid != uid

      && request.resource.data.uid == followingUid;

    allow delete: if isMe(uid);

    allow update: if false;
  }

}
/* =====================================================
   ORO-AI CHAT HISTORY
===================================================== */

match /users/{uid}/aiChats/{sessionId}/messages/{messageId} {

  // Abbaa account qofatu History dubbisuu danda'a.
  function isHistoryOwner() {
    return request.auth != null
      && request.auth.uid == uid;
  }

  // History dubbisuu fi query gochuu.
  allow get, list: if isHistoryOwner();

  // Ergaa haaraa kuusuu.
  allow create: if isHistoryOwner()

    && request.resource.data.keys().hasAll([
      "role",
      "content",
      "createdAtMs"
    ])

    && request.resource.data.keys().hasOnly([
      "role",
      "content",
      "createdAtMs",
      "createdAt"
    ])

    && request.resource.data.role in [
      "user",
      "model"
    ]

    && request.resource.data.content is string
    && request.resource.data.content.size() <= 12000

    && request.resource.data.createdAtMs is number

    && (
      !request.resource.data.keys().hasAny(["createdAt"])
      || request.resource.data.createdAt is timestamp
    );

  // Ergaa duraan kuufame jijjiiruu hin hayyamu.
  allow update, delete: if false;
}
/* END USERS MATCH */
/* =====================================================
   8. POSTS
===================================================== */

match /posts/{postId} {

      /* READ POSTS */

      allow get, list: if signed()
        && (
          resource.data.get("privacy", "private") == "public"
          || resource.data.get(
            "userId",
            resource.data.get("uid", "")
          ) == request.auth.uid
        );


      /* CREATE POST */

      allow create: if signed()

        && request.resource.data.userId == request.auth.uid

        && (
          !request.resource.data.keys().hasAny(["likesCount"])
          || (
            request.resource.data.likesCount is int
            && request.resource.data.likesCount >= 0
          )
        )

        && (
          !request.resource.data.keys().hasAny(["commentsCount"])
          || (
            request.resource.data.commentsCount is int
            && request.resource.data.commentsCount >= 0
          )
        );


      /* UPDATE POST */

      allow update: if signed()

        && request.resource.data.userId == resource.data.userId

        && (

          /* OWNER UPDATE */

          (
            resource.data.userId == request.auth.uid

            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "text",
                "caption",
                "mediaURL",
                "mediaType",
                "updatedAt"
              ])
          )

          ||

          validLikeCountUpdate(postId)

          ||

          validCommentCountUpdate(postId)
        );


      /* DELETE POST */

      allow delete: if signed()
        && resource.data.userId == request.auth.uid;


      /* POST LIKES */

      match /likes/{uid} {

        allow read: if signed();

        allow create: if isMe(uid)

          && exists(
            /databases/$(database)/documents/posts/$(postId)
          )

          && get(
            /databases/$(database)/documents/posts/$(postId)
          ).data.userId != uid

          && request.resource.data.userId == uid

          && request.resource.data.createdAt is timestamp
          && request.resource.data.time is timestamp

          && request.resource.data.keys().hasOnly([
            "userId",
            "createdAt",
            "time"
          ]);

        allow delete: if isMe(uid)
          && resource.data.userId == uid;

        allow update: if false;
      }


      /* POST COMMENTS */

      match /comments/{commentId} {

        allow read: if signed();


        /* CREATE COMMENT / REPLY */

        allow create: if signed()

          && request.resource.data.userId == request.auth.uid

          && request.resource.data.postId == postId

          && validText(request.resource.data.text, 500)

          && request.resource.data.depth is int
          && request.resource.data.depth >= 0
          && request.resource.data.depth <= 3

          && request.resource.data.deleted == false

          && request.resource.data.createdAt is timestamp
          && request.resource.data.updatedAt is timestamp

          && (

            (
              request.resource.data.parentCommentId == null
              && request.resource.data.depth == 0
            )

            ||

            (
              request.resource.data.parentCommentId is string
              && request.resource.data.parentCommentId != commentId
              && request.resource.data.depth > 0

              && exists(
                /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.parentCommentId)
              )

              && get(
                /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.parentCommentId)
              ).data.deleted == false
            )
          );


        /* UPDATE COMMENT */

        allow update: if signed()

          && (

            (
              resource.data.userId == request.auth.uid

              && request.resource.data.userId == resource.data.userId
              && request.resource.data.postId == resource.data.postId
              && request.resource.data.depth == resource.data.depth

              && request.resource.data.parentCommentId
                == resource.data.parentCommentId

              && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  "text",
                  "deleted",
                  "updatedAt"
                ])

              && (
                !request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasAny(["text"])
                || validText(request.resource.data.text, 500)
              )

              && (
                !request.resource.data.diff(resource.data)
                  .affectedKeys()
                  .hasAny(["deleted"])
                || request.resource.data.deleted is bool
              )
            )

            ||

            validReplyCountUpdate(postId, commentId)
          );


        /* DELETE COMMENT */

        allow delete: if signed()
          && resource.data.userId == request.auth.uid;
      }
    }


/* =====================================================
   9. CHATS — ORO-CONNECT PRODUCTION
===================================================== */

match /chats/{chatId} {

  /* CHAT READ */
  allow read: if chatMember(chatId);

  /* CREATE CHAT */
  allow create: if newChatMember(chatId);

  /* UPDATE CHAT */
  allow update: if chatMember(chatId)

    && request.resource.data.participants
      == resource.data.participants

    && request.resource.data.diff(resource.data)
      .affectedKeys()
      .hasOnly([
        "updatedAt",
        "lastMessage",
        "lastMessageAt",
        "typingStatus"
      ])

    /* LAST MESSAGE */
    && (
      !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(["lastMessage"])

      || (
        request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 5000
      )
    )

    /* LAST MESSAGE TIME */
    && (
      !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(["lastMessageAt"])

      || request.resource.data.lastMessageAt is timestamp
    )

    /* UPDATED TIME */
    && (
      !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(["updatedAt"])

      || request.resource.data.updatedAt is timestamp
    )

    /* TYPING STATUS */
    && (
      !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(["typingStatus"])

      || (
        request.resource.data.typingStatus is map

        && request.resource.data.typingStatus
          .diff(resource.data.get("typingStatus", {}))
          .affectedKeys()
          .hasOnly([request.auth.uid])

        && request.resource.data.typingStatus
          .get(request.auth.uid, false) is bool
      )
    );

  /* CHAT DOCUMENT DIRECT DELETE DISABLED */
  allow delete: if false;


  /* =====================================================
     CHAT MESSAGES
  ===================================================== */

  match /messages/{messageId} {

    /* READ MESSAGES */
    allow read: if chatMember(chatId);


    /* =================================================
       SEND MESSAGE
    ================================================= */

    allow create: if chatMember(chatId)

      && request.resource.data.senderId
        == request.auth.uid

      && request.resource.data.receiverId is string

      && request.resource.data.receiverId in get(
        /databases/$(database)/documents/chats/$(chatId)
      ).data.participants

      && request.resource.data.receiverId
        != request.auth.uid

      && request.resource.data.status == "sent"

      && request.resource.data.type in [
        "text",
        "image",
        "video",
        "audio",
        "file",
        "voice",
        "document"
      ]

      /* TEXT MESSAGE */
      && (
        (
          request.resource.data.type == "text"

          && validText(
            request.resource.data.text,
            5000
          )
        )

        ||

        /* MEDIA MESSAGE */
        (
          request.resource.data.type != "text"

          && (
            (
              request.resource.data.get("mediaUrl", "") is string

              && request.resource.data.get("mediaUrl", "").size() > 0

              && request.resource.data.get("mediaUrl", "").size() <= 2000
            )

            ||

            (
              request.resource.data.get("mediaURL", "") is string

              && request.resource.data.get("mediaURL", "").size() > 0

              && request.resource.data.get("mediaURL", "").size() <= 2000
            )

            ||

            (
              request.resource.data.get("audioUrl", "") is string

              && request.resource.data.get("audioUrl", "").size() > 0

              && request.resource.data.get("audioUrl", "").size() <= 2000
            )
          )
        )
      );


    /* =================================================
       UPDATE MESSAGE
    ================================================= */

    allow update: if chatMember(chatId)

      && (

        /* =============================================
           1. SENDER EDITS TEXT
        ============================================= */

        (
          resource.data.senderId == request.auth.uid

          && resource.data.type == "text"

          && resource.data.get(
            "deletedForEveryone",
            false
          ) != true

          && request.resource.data.senderId
            == resource.data.senderId

          && request.resource.data.receiverId
            == resource.data.receiverId

          && request.resource.data.type
            == resource.data.type

          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "text",
              "updatedAt"
            ])

          && validText(
            request.resource.data.text,
            5000
          )

          && request.resource.data.updatedAt is timestamp
        )


        ||

        /* =============================================
           2. RECEIVER UPDATES DELIVERY STATUS
        ============================================= */

        (
          resource.data.receiverId == request.auth.uid

          && resource.data.get(
            "deletedForEveryone",
            false
          ) != true

          && request.resource.data.senderId
            == resource.data.senderId

          && request.resource.data.receiverId
            == resource.data.receiverId

          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly(["status"])

          && request.resource.data.status in [
            "delivered",
            "read"
          ]

          && resource.data.status in [
            "sent",
            "delivered"
          ]
        )


        ||

        /* =============================================
           3. SENDER DELETES MESSAGE FOR EVERYONE
        ============================================= */

        (
          resource.data.senderId == request.auth.uid

          && resource.data.get(
            "deletedForEveryone",
            false
          ) != true

          && request.resource.data.senderId
            == resource.data.senderId

          && request.resource.data.receiverId
            == resource.data.receiverId

          && request.resource.data.type
            == resource.data.type

          && request.resource.data.deletedForEveryone
            == true

          && request.resource.data.deletedBy
            == request.auth.uid

          && request.resource.data.deletedAt is timestamp

          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "deletedForEveryone",
              "deletedBy",
              "deletedAt",
              "text",
              "mediaUrl",
              "mediaURL",
              "audioUrl",
              "updatedAt"
            ])

          /* CLEAR TEXT */
          && (
            !request.resource.data.keys().hasAny(["text"])

            || request.resource.data.text == ""
          )

          /* CLEAR MEDIA URL */
          && (
            !request.resource.data.keys().hasAny(["mediaUrl"])

            || request.resource.data.mediaUrl == ""
          )

          && (
            !request.resource.data.keys().hasAny(["mediaURL"])

            || request.resource.data.mediaURL == ""
          )

          /* CLEAR AUDIO URL */
          && (
            !request.resource.data.keys().hasAny(["audioUrl"])

            || request.resource.data.audioUrl == ""
          )

          /* OPTIONAL UPDATED TIME */
          && (
            !request.resource.data.keys().hasAny(["updatedAt"])

            || request.resource.data.updatedAt is timestamp
          )
        )
      );


    /* =================================================
       DIRECT DELETE DISABLED
       USE DELETE FOR EVERYONE
    ================================================= */

    allow delete: if false;

  }
}
    /* =====================================================
       11. NOTIFICATIONS
    ===================================================== */

    match /notifications/{id} {

      /* READ */

      allow get, list: if signed()
        && resource.data.toUserId == request.auth.uid;


      /* CREATE */

            /* CREATE */

      allow create: if signed()

        && request.resource.data.fromUserId == request.auth.uid

        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid

        && request.resource.data.type in [
          "like",
          "comment",
          "share",
          "follow",
          "message",
          "new_voice_message",
          "reply",
          "mention",
          "incoming_call",
          "unfollow"
        ]

        && request.resource.data.seen is bool
        && request.resource.data.createdAt is timestamp

        && request.resource.data.keys().hasOnly([
          "fromUserId",
          "toUserId",
          "type",
          "seen",
          "read",
          "createdAt",
          "time",
          "message",
          "text",
          "link",
          "postId",
          "commentId",
          "fromUserName",
          "fromUserPic",
          "senderName",
          "senderPhoto",
          "status",
          "chatId",
          "callId",
          "callType",
          "textSnippet",
          "parentCommentId"
        ])

        && (
          !request.resource.data.keys().hasAny(["read"])
          || request.resource.data.read is bool
        )

        && (
          !request.resource.data.keys().hasAny(["time"])
          || request.resource.data.time is timestamp
        )

        && (
          !request.resource.data.keys().hasAny(["text"])
          || (
            request.resource.data.text is string
            && request.resource.data.text.size() <= 500
          )
        )

        && (
          !request.resource.data.keys().hasAny(["link"])
          || (
            request.resource.data.link is string
            && request.resource.data.link.size() <= 500
          )
        )

        && (
          !request.resource.data.keys().hasAny(["status"])
          || request.resource.data.status == "unread"
        )

        && (
          !request.resource.data.keys().hasAny(["postId"])
          || request.resource.data.postId == null
          || request.resource.data.postId is string
        )

        && (
          !request.resource.data.keys().hasAny(["commentId"])
          || request.resource.data.commentId == null
          || request.resource.data.commentId is string
        )

        && (
          !request.resource.data.keys().hasAny(["parentCommentId"])
          || request.resource.data.parentCommentId == null
          || request.resource.data.parentCommentId is string
        )

        && (
          !request.resource.data.keys().hasAny(["chatId"])
          || request.resource.data.chatId == null
          || request.resource.data.chatId is string
        )

        && (
          !request.resource.data.keys().hasAny(["callId"])
          || request.resource.data.callId == null
          || request.resource.data.callId is string
        )

        && (
          !request.resource.data.keys().hasAny(["callType"])
          || request.resource.data.callType == null
          || request.resource.data.callType in ["voice", "video"]
        )

        && (
          !request.resource.data.keys().hasAny(["message"])
          || (
            request.resource.data.message is string
            && request.resource.data.message.size() <= 500
          )
        )

        && (
          !request.resource.data.keys().hasAny(["textSnippet"])
          || (
            request.resource.data.textSnippet is string
            && request.resource.data.textSnippet.size() <= 500
          )
        )

        && (
          !request.resource.data.keys().hasAny(["fromUserName"])
          || (
            request.resource.data.fromUserName is string
            && request.resource.data.fromUserName.size() <= 100
          )
        )

        && (
          !request.resource.data.keys().hasAny(["fromUserPic"])
          || (
            request.resource.data.fromUserPic is string
            && request.resource.data.fromUserPic.size() <= 1000
          )
        )

        && (
          !request.resource.data.keys().hasAny(["senderName"])
          || (
            request.resource.data.senderName is string
            && request.resource.data.senderName.size() <= 100
          )
        )

        && (
          !request.resource.data.keys().hasAny(["senderPhoto"])
          || (
            request.resource.data.senderPhoto is string
            && request.resource.data.senderPhoto.size() <= 1000
          )
        );

      /* UPDATE: RECEIVER ONLY */

      allow update: if signed()

        && resource.data.toUserId == request.auth.uid

        && request.resource.data.toUserId
          == resource.data.toUserId

        && request.resource.data.fromUserId
          == resource.data.fromUserId

        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["seen", "read", "status"])

        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(["seen"])
          || request.resource.data.seen is bool
        )

        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(["read"])
          || request.resource.data.read is bool
        )

        && (
          !request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasAny(["status"])
          || request.resource.data.status in ["unread", "read"]
        );


      /* DELETE: SENDER OR RECEIVER */

      allow delete: if signed()
        && (
          resource.data.toUserId == request.auth.uid
          || resource.data.fromUserId == request.auth.uid
        );
    }


    /* =====================================================
       12. STORIES
    ===================================================== */

    match /stories/{id} {

      allow read: if signed();

      allow create: if signed()

        && request.resource.data.userId == request.auth.uid

        && validText(request.resource.data.mediaURL, 2000)

        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp

        && request.resource.data.expiresAt
          > request.resource.data.createdAt

        && request.resource.data.expiresAt
          <= request.resource.data.createdAt + duration.value(24, "h");

      allow update: if signed()

        && resource.data.userId == request.auth.uid

        && request.resource.data.userId == resource.data.userId

        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["caption", "updatedAt"]);

      allow delete: if signed()
        && resource.data.userId == request.auth.uid;
    }


    /* =====================================================
       13. VIDEOS
    ===================================================== */

    match /videos/{id} {

      allow read: if signed();

      allow create: if signed()

        && request.resource.data.userId == request.auth.uid

        && validText(request.resource.data.mediaURL, 2000)

        && request.resource.data.duration is number

        && request.resource.data.duration > 0
        && request.resource.data.duration <= 60

        && request.resource.data.createdAt is timestamp;

      allow update: if signed()

        && resource.data.userId == request.auth.uid

        && request.resource.data.userId == resource.data.userId

        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["caption", "updatedAt"]);

      allow delete: if signed()
        && resource.data.userId == request.auth.uid;
    }


    /* =====================================================
       14. CALLS
    ===================================================== */

    match /calls/{callId} {

      /* READ ONE CALL */

      allow get: if isCallParticipant(resource.data)
        && validCall(resource.data, callId);


      /* QUERY CALLS */

      allow list: if signed()
        && validCall(resource.data, callId)
        && request.auth.uid in resource.data.participantIDs;


      /* CREATE CALL */

      allow create: if signed()

        && validCall(request.resource.data, callId)

        && request.resource.data.callerID == request.auth.uid

        && request.resource.data.status == "calling";


      /* UPDATE CALL */

      allow update: if isCallParticipant(resource.data)

        && validCall(resource.data, callId)
        && validCall(request.resource.data, callId)

        && request.resource.data.callerID
          == resource.data.callerID

        && request.resource.data.receiverID
          == resource.data.receiverID

        && request.resource.data.roomID
          == resource.data.roomID

        && request.resource.data.participantIDs
          == resource.data.participantIDs

        && request.resource.data.type
          == resource.data.type

        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "status",
            "updatedAt",
            "acceptedAt",
            "endedAt",
            "rejectedAt",
            "callerName",
            "receiverName"
          ])

        && (
          request.resource.data.status == resource.data.status

          || validCallTransition(
            resource.data.status,
            request.resource.data.status,
            resource.data.callerID,
            resource.data.receiverID
          )
        );

      allow delete: if false;
    }


    /* =====================================================
       15. CALL LOGS
    ===================================================== */

    match /callLogs/{roomID} {

      /* READ ONE LOG */

      allow get: if validLog(resource.data, roomID)
        && isLogParticipant(resource.data);


      /* QUERY CALL LOGS */

      allow list: if validLog(resource.data, roomID)
        && isLogParticipant(resource.data);


      /* CREATE LOG */

      allow create: if validLog(request.resource.data, roomID)

        && isLogParticipant(request.resource.data)

        && matchesCall(request.resource.data, roomID)

        && request.resource.data.updatedAt == request.time;


      /* UPDATE LOG */

      allow update: if signed()

        && validLog(resource.data, roomID)
        && isLogParticipant(resource.data)

        && matchesCall(resource.data, roomID)

        && validLog(request.resource.data, roomID)

        && request.resource.data.roomID == resource.data.roomID
        && request.resource.data.callerID == resource.data.callerID
        && request.resource.data.receiverID == resource.data.receiverID

        && request.resource.data.participantIDs
          == resource.data.participantIDs

        && request.resource.data.type == resource.data.type
        && request.resource.data.createdAt == resource.data.createdAt

        && (

          /* STATUS / NAME UPDATE */

          (
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly([
                "status",
                "updatedAt",
                "callerName",
                "receiverName"
              ])

            && validLogStatusUpdate()

            && request.resource.data.updatedAt == request.time
          )

          ||

          /* HIDE LOG */

          validHideUpdate()
        );


      /* NO DIRECT DELETE */

      allow delete: if false;
    }


    /* =====================================================
       16. REPORTS
    ===================================================== */

    match /reports/{reportId} {

      allow create: if signed()

        && request.resource.data.reporterId == request.auth.uid

        && validText(request.resource.data.postId, 200)

        && request.resource.data.postOwnerId is string
        && request.resource.data.postOwnerId != request.auth.uid

        && validText(request.resource.data.reason, 1000)
        && request.resource.data.reason.size() >= 3

        && request.resource.data.timestamp is timestamp

        && request.resource.data.status == "pending"
        && request.resource.data.severity == "normal"
        && request.resource.data.reviewed == false
        && request.resource.data.source == "post"
        && request.resource.data.schemaVersion == 1

        && request.resource.data.keys().hasOnly([
          "postId",
          "reporterId",
          "postOwnerId",
          "reason",
          "timestamp",
          "status",
          "severity",
          "reviewed",
          "source",
          "schemaVersion"
        ]);

      allow read, update, delete: if false;
    }


    /* =====================================================
       17. ADS
    ===================================================== */

    match /ads/{id} {
      allow read: if true;
      allow write: if false;
    }


    /* =====================================================
       18. SECRETS
    ===================================================== */

    match /secrets/{id} {
      allow read, write: if false;
    }

/* =====================================================
   19. USERNAME RESERVATION
===================================================== */

match /usernames/{username} {

    // User seene qofti username jiraachuu isaa sakatta'uu danda'a.
    allow get: if signed()
        && (
            !exists(
                /databases/$(database)/documents/usernames/$(username)
            )
            || resource.data.uid == request.auth.uid
        );

    // Username list guutuu dubbisuun hin hayyamamu.
    allow list: if false;

    // Username haaraa reserve gochuu.
    allow create: if signed()

        && request.resource.data.keys().hasAll([
            "uid",
            "username",
            "updatedAt"
        ])

        && request.resource.data.keys().hasOnly([
            "uid",
            "username",
            "updatedAt"
        ])

        && request.resource.data.uid == request.auth.uid

        && request.resource.data.username == username

        && username.matches('^[a-z0-9_]{3,15}$')

        && request.resource.data.updatedAt == request.time;

    // Username abbaa isaa qofatu haaromsuu danda'a.
    allow update: if signed()

        && resource.data.uid == request.auth.uid

        && request.resource.data.uid == request.auth.uid

        && request.resource.data.username == username

        && request.resource.data.updatedAt == request.time

        && request.resource.data.keys().hasAll([
            "uid",
            "username",
            "updatedAt"
        ])

        && request.resource.data.keys().hasOnly([
            "uid",
            "username",
            "updatedAt"
        ])

        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
                "uid",
                "username",
                "updatedAt"
            ]);

    // Username abbaa isaa qofatu haquu danda'a.
    allow delete: if signed()
        && resource.data.uid == request.auth.uid;
}
/* =====================================================
   20. DEFAULT DENY
===================================================== */

match /{document=**} {
    allow read, write: if false;
}

  }
}
