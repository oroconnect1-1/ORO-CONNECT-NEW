{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "storage.rules",
      "firestore.indexes.json",
      "package.json",
      "AndroidManifest.xml",
      "cors.json",
      "functions/**",
      "android/**",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}